# SaaS platform owner payment account (separate from every club's YooKassa)
SUPER_YOOKASSA_SHOP_ID=
SUPER_YOOKASSA_SECRET_KEY=test_...
SUPER_YOOKASSA_SBP_ENABLED=1
SUPER_YOOKASSA_AUTO_RENEW_ENABLED=1

# External Telegram watchdog. Keep real values only in production .monitor.env.
MONITOR_BOT_TOKEN=
MONITOR_CHAT_ID=
MONITOR_HEALTH_URL=https://speedycrm.ru/ready
MONITOR_PROJECT_DIR=/root/github.io-test

# Native Web email OTP. Keep disabled until mail provider and staging test route are approved.
WEB_NATIVE_AUTH_ENABLED=0
WEB_NATIVE_EMAIL_BINDING_ENABLED=0
