# Copy to /root/speedycrm-staging/.staging-mail.env on the server only.
# Never commit or send actual values in chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1

# Alternative to SMTP when outbound port 587 is blocked.
EMAIL_PROVIDER=yandex_postbox
YANDEX_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
YANDEX_POSTBOX_REGION=ru-central1
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
EMAIL_FROM_EMAIL=noreply@speedycrm.ru
